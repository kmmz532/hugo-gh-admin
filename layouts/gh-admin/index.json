{{- /* 管理画面（一括管理・編集・テンプレート・サムネイル）が読む索引。検索用の /index.json とは分ける。
  1 ファイル indexPageSize 件まで。2 つ目以降は /gh-admin/index/<n>.json */ -}}
{{- $size := int (site.Params.indexPageSize | default 50) -}}
{{- $v := now.Unix -}}
{{- $items := slice -}}
{{- /* external-meta.html と post-url.html はテーマが用意する。用意していないテーマ（外部テーマ）では、タイトルと .RelPermalink を使う */ -}}
{{- $hasMeta := templates.Exists "partials/external-meta.html" -}}
{{- $hasURL := templates.Exists "partials/post-url.html" -}}
{{- range where site.RegularPages "Section" "posts" -}}
{{- $meta := dict "title" .Title "images" slice -}}
{{- if $hasMeta }}{{ $meta = partialCached "external-meta.html" . .File.Path }}{{ end -}}
{{- $url := .RelPermalink -}}
{{- if $hasURL }}{{ $url = partial "post-url.html" . }}{{ end -}}
{{- $items = $items | append (dict "slug" .File.ContentBaseName "title" $meta.title "url" $url "external" (.Params.external | default "") "date" (.Date.Format "2006-01-02") "images" $meta.images "tags" .Params.tags "categories" .Params.categories) -}}
{{- end -}}
{{- /* 固定ページ（content/<slug>.md）。検索・一覧など layout や type を持つテーマ側のページは除く。1 つ目のファイルにだけ入れる */ -}}
{{- $pageItems := slice -}}
{{- range where site.RegularPages "Section" "" -}}
  {{- if and (not .Params.layout) (not .Params.type) .File -}}
    {{- $pageItems = $pageItems | append (dict "slug" .File.ContentBaseName "title" .Title "url" .RelPermalink "menu" (isset .Params "menu") "noindex" (eq (.Params.robots | default "") "noindex")) -}}
  {{- end -}}
{{- end -}}
{{- $total := len $items -}}
{{- $pages := div (add $total (sub $size 1)) $size -}}
{{- range $p := seq $pages -}}
  {{- $next := index (dict) "none" -}}
  {{- if lt $p $pages -}}{{- $next = printf "%s?v=%d" (relURL (printf "gh-admin/index/%d.json" (add $p 1))) $v -}}{{- end -}}
  {{- if gt $p 1 -}}
    {{- $chunk := first $size (after (mul (sub $p 1) $size) $items) -}}
    {{- $_ := (resources.FromString (printf "gh-admin/index/%d.json" $p) (dict "items" $chunk "next" $next "total" $total | jsonify)).Publish -}}
  {{- end -}}
{{- end -}}
{{- $next1 := index (dict) "none" -}}
{{- if gt $pages 1 -}}{{- $next1 = printf "%s?v=%d" (relURL "gh-admin/index/2.json") $v -}}{{- end -}}
{{- /* 浮かせる管理ボタン（gh-admin/js/float.js）が読む設定。テーマの <head> に meta が無いページでも使えるように、1 つ目のファイルに入れる */ -}}
{{- $config := partial "gh-admin/settings.html" . | transform.Unmarshal -}}
{{- dict "items" (first $size $items) "next" $next1 "total" $total "pages" $pageItems "config" $config | jsonify -}}
